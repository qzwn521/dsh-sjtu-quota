{
  "name": "dsh-sjtu-quota",
  "version": "0.1.1-beta.1",
  "description": "SJTU API request pacing and cancellable rate-limit recovery for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.1.5-rc.2 || 0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2 || ~4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2 || 0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sjtu",
    "rate-limit",
    "token-usage",
    "429"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": true,
    "apiKeys": [],
    "permissions": {
      "filesystem": "Own aggregate quota ledger and lock under DSH_HOME; user-configured ledger path if supplied",
      "environment": [
        "DSH_HOME"
      ],
      "modelRequests": "Observes usage and delays selected routes; upstream authentication remains owned by DSH"
    },
    "dataRetention": "Rolling seven-day local accounting, plus aggregate counters and calibration; no automatic uploads"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack:local": "node scripts/pack.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "node scripts/check-release.mjs && node --test test/*.test.js"
  },
  "author": "qzwn521",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzwn521/dsh-sjtu-quota.git"
  },
  "homepage": "https://github.com/qzwn521/dsh-sjtu-quota#readme",
  "bugs": {
    "url": "https://github.com/qzwn521/dsh-sjtu-quota/issues"
  }
}
